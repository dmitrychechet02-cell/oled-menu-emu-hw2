{
  "name": "oled-menu-emu",
  "version": "0.1.0",
  "private": true,
  "description": "Эмулятор меню для OLED 128x64 (SSD1309): C-ядро в WebAssembly + веб-интерфейс",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build-wasm.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test-unit.mjs",
    "test:e2e": "npm run build && playwright test",
    "lint": "npm run lint:c && npm run lint:js",
    "lint:c": "node scripts/lint-c.mjs",
    "lint:js": "eslint . && prettier --check web tests/e2e scripts",
    "format": "make format && prettier --write web tests/e2e scripts",
    "sync:agents": "node scripts/sync-agents.mjs",
    "check:agents": "node scripts/sync-agents.mjs --check",
    "agent:doctor": "node scripts/agent-workflow.mjs doctor",
    "agent:resume": "node scripts/agent-workflow.mjs resume",
    "agent:checkpoint": "node scripts/agent-workflow.mjs checkpoint",
    "test:hooks": "node --test tests/hooks/*.test.mjs",
    "gsd:progress": "node scripts/agent-workflow.mjs gsd progress table",
    "gsd:check": "node scripts/agent-workflow.mjs gsd validate health"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0"
  }
}
